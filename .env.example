# Copy to an ignored .env for local use. Never commit real credentials.
VASA_ENVIRONMENT=development
VASA_DATABASE_URL=postgresql+asyncpg://vasa:vasa_local_only@127.0.0.1:54329/vasa
VASA_REDIS_URL=redis://127.0.0.1:6389/0
# Provider keys belong in secure cloud settings or private ignored configuration.
VASA_LLM_PRIMARY=openai
VASA_OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible gateway; omitted defaults to https://api.openai.com/v1.
# VASA_OPENAI_BASE_URL=https://your-gateway.example/v1
VASA_ANTHROPIC_MODEL=claude-sonnet-4-6
VASA_SPEECH_MODEL_ROOT=.local/speech
VASA_TTS_PROVIDER=deepgram
# Deepgram Aura TTS is the user-selected interim default.
# Supply DEEPGRAM_API_KEY securely; never commit its value.
# VASA_DEEPGRAM_MODEL=aura-2-thalia-en
# Speechify remains optional: VASA_TTS_PROVIDER=speechify.
# Supply SPEECHIFY_API_KEY securely; never commit its value.
# VASA_SPEECHIFY_VOICE_ID=geffen_32
# Optional candidates: VASA_TTS_PROVIDER=kokoro-int8, kitten-micro or piper.
# Prepare Kitten with scripts/prepare_speech.py --kitten-micro before selection.
# VASA_KITTEN_MODEL_DIR=.local/speech/kitten-micro
# VASA_KITTEN_NUM_THREADS=1
# VASA_KOKORO_MODEL_DIR=.local/speech/kokoro-int8
# VASA_KOKORO_NUM_THREADS=1
VASA_STT_NUM_THREADS=1

# SaaS rollout requires separately reviewed migration 0007 and transactional email.
# Keep disabled on staging until the operator migration/backup gate is complete.
VASA_SAAS_ENABLED=false
# Explicit canonical origin repairs TLS termination without trusting forwarded headers.
# VASA_PUBLIC_ORIGIN=https://vasa.example.com
VASA_REGISTRATION_APPROVAL_REQUIRED=false
# SMTP credentials belong only in private environment settings.
# Web-only .local/smtp.env; Reloop requires a verified sending domain/address.
# VASA_SMTP_HOST=smtp.reloop.sh
# VASA_SMTP_PORT=587
# VASA_SMTP_USERNAME=replace-with-private-reloop-api-key
# VASA_SMTP_PASSWORD=the-same-private-reloop-api-key
# VASA_SMTP_SENDER=VASA <no-reply@example.com>
VASA_SMTP_STARTTLS=true
# Keep false until a real test message is received from the verified sender.
VASA_SMTP_DELIVERY_VERIFIED=false
# Optional public contact form destination; remains disabled when omitted.
# VASA_CONTACT_RECIPIENT=support@example.com
