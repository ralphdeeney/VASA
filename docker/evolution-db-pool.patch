+package whatsmeow_service
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+
+	"go.mau.fi/whatsmeow/store/sqlstore"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// postgresSessionStore borrows the process-owned auth pool. Container.Close must
+// never be called by an instance: it would close the shared pool for all clients.
+// The initializer owns pool limits and closes it after process/client shutdown.
+func postgresSessionStore(ctx context.Context, db *sql.DB, log waLog.Logger) (*sqlstore.Container, error) {
+	if db == nil {
+		return nil, errors.New("auth_pool_required")
+	}
+	container := sqlstore.NewWithDB(db, "postgres", log)
+	if err := container.Upgrade(ctx); err != nil {
+		// This is a borrowed pool, including when initialization fails.
+		return nil, err
+	}
+	return container, nil
+}
