+// Explicit opt-in integration target; requires a disposable dedicated database.
+// Never use an application/staging database or emit connection URLs/device data.
+func TestPostgresSessionStoreRealPoolLifecycle(t *testing.T) {
+	raw := os.Getenv("VASA_EVOLUTION_POOL_TEST_DSN")
+	if raw == "" {
+		t.Skip("set VASA_EVOLUTION_POOL_TEST_DSN to a disposable loopback database")
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed.Hostname() != "127.0.0.1" || parsed.Port() != "54329" || !strings.HasPrefix(parsed.Path, "/vasa_pool_test_") || parsed.Scheme != "postgres" {
+		t.Fatal("disposable loopback database required")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	observer, err := sql.Open("postgres", raw)
+	if err != nil {
+		t.Fatal("observer initialization failed")
+	}
+	defer observer.Close()
+	count := func(name string) int {
+		var n int
+		if err := observer.QueryRowContext(ctx, "SELECT count(*) FROM pg_stat_activity WHERE application_name=$1", name).Scan(&n); err != nil {
+			t.Fatal("aggregate connection inspection failed")
+		}
+		return n
+	}
+	dsn := func(name string) string {
+		u := *parsed
+		q := u.Query()
+		q.Set("application_name", name)
+		u.RawQuery = q.Encode()
+		return u.String()
+	}
+	originalName := fmt.Sprintf("vasa-pool-original-%d", time.Now().UnixNano())
+	var original []*sqlstore.Container
+	defer func() {
+		for _, c := range original {
+			_ = c.Close()
+		}
+	}()
+	for i := 0; i < 8; i++ {
+		c, err := sqlstore.New(ctx, "postgres", dsn(originalName), nil)
+		if err != nil {
+			t.Fatal("original path initialization failed")
+		}
+		original = append(original, c)
+	}
+	if count(originalName) < 8 {
+		t.Fatal("original path did not allocate independent pools")
+	}
+	for _, c := range original {
+		_ = c.Close()
+	}
+	original = nil
+	deadline := time.Now().Add(3 * time.Second)
+	for count(originalName) != 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if count(originalName) != 0 {
+		t.Fatal("original pools did not close")
+	}
+	sharedName := fmt.Sprintf("vasa-pool-shared-%d", time.Now().UnixNano())
+	owner, err := sql.Open("postgres", dsn(sharedName))
+	if err != nil {
+		t.Fatal("owner initialization failed")
+	}
+	defer owner.Close()
+	owner.SetMaxOpenConns(2)
+	owner.SetMaxIdleConns(2)
+	// Existing schema is current after original-path initialization: no concurrent migrations.
+	var wg sync.WaitGroup
+	failures := make(chan bool, 120)
+	for i := 0; i < 120; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			c, err := postgresSessionStore(ctx, owner, nil)
+			if err == nil {
+				_, err = c.GetAllDevices(ctx)
+			}
+			failures <- err != nil
+		}()
+	}
+	wg.Wait()
+	close(failures)
+	for failed := range failures {
+		if failed {
+			t.Fatal("real concurrent reuse failed")
+		}
+	}
+	if count(sharedName) > 2 || owner.Stats().MaxOpenConnections != 2 {
+		t.Fatal("shared pool exceeded configured bound")
+	}
+	// Cancelled startup must not close the pool used by other active instances.
+	cancelled, stop := context.WithCancel(ctx)
+	stop()
+	if _, err = postgresSessionStore(cancelled, owner, nil); err == nil {
+		t.Fatal("cancelled startup accepted")
+	}
+	if err = owner.PingContext(ctx); err != nil {
+		t.Fatal("cancelled startup closed owner pool")
+	}
+	if err = owner.Close(); err != nil {
+		t.Fatal("owner shutdown failed")
+	}
+	deadline = time.Now().Add(3 * time.Second)
+	for count(sharedName) != 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if count(sharedName) != 0 {
+		t.Fatal("owner shutdown retained connections")
+	}
+}
