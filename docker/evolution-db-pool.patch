+func expectCurrentSessionSchema(mock sqlmock.Sqlmock) {
+	mock.ExpectQuery("SELECT EXISTS").WithArgs("whatsmeow_version", "compat").WillReturnRows(sqlmock.NewRows([]string{"exists"}).AddRow(true))
+	mock.ExpectQuery("SELECT version, compat FROM whatsmeow_version LIMIT 1").WillReturnRows(sqlmock.NewRows([]string{"version", "compat"}).AddRow(len(upgrades.Table), len(upgrades.Table)))
+}
+
+func TestPostgresSessionStoreRequiresOwnerPool(t *testing.T) {
+	if container, err := postgresSessionStore(context.Background(), nil, nil); err == nil || container != nil {
+		t.Fatal("missing owner pool accepted")
+	}
+}
+
+func TestPostgresSessionStoreReusesBoundedPoolAcross120Restarts(t *testing.T) {
+	db, mock, err := sqlmock.New(sqlmock.MonitorPingsOption(true))
+	if err != nil {
+		t.Fatal("mock initialization failed")
+	}
+	db.SetMaxOpenConns(2)
+	db.SetMaxIdleConns(2)
+	for i := 0; i < 120; i++ {
+		expectCurrentSessionSchema(mock)
+		if _, err = postgresSessionStore(context.Background(), db, nil); err != nil {
+			t.Fatal("borrowed store initialization failed")
+		}
+	}
+	if db.Stats().MaxOpenConnections != 2 || db.Stats().OpenConnections > 2 {
+		t.Fatal("owner bounds changed")
+	}
+	mock.ExpectPing()
+	if err = db.Ping(); err != nil {
+		t.Fatal("shared pool closed by store")
+	}
+	mock.ExpectClose()
+	if err = db.Close(); err != nil {
+		t.Fatal("owner shutdown failed")
+	}
+	if err = mock.ExpectationsWereMet(); err != nil {
+		t.Fatal("owner lifecycle expectations failed")
+	}
+}
+
+func TestPostgresSessionStoreFailureDoesNotCloseAnotherClientPool(t *testing.T) {
+	db, mock, err := sqlmock.New(sqlmock.MonitorPingsOption(true))
+	if err != nil {
+		t.Fatal("mock initialization failed")
+	}
+	mock.ExpectQuery("SELECT EXISTS").WillReturnError(errors.New("test upgrade failure"))
+	if _, err = postgresSessionStore(context.Background(), db, nil); err == nil {
+		t.Fatal("upgrade failure ignored")
+	}
+	mock.ExpectPing()
+	if err = db.Ping(); err != nil {
+		t.Fatal("failure closed shared pool")
+	}
+	expectCurrentSessionSchema(mock)
+	if _, err = postgresSessionStore(context.Background(), db, nil); err != nil {
+		t.Fatal("retry failed")
+	}
+	mock.ExpectClose()
+	_ = db.Close()
+	if err = mock.ExpectationsWereMet(); err != nil {
+		t.Fatal("failure ownership expectations failed")
+	}
+}
+
+func TestPostgresSessionStoreConcurrentBorrowers(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatal("mock initialization failed")
+	}
+	db.SetMaxOpenConns(2)
+	db.SetMaxIdleConns(2)
+	mock.MatchExpectationsInOrder(false)
+	for i := 0; i < 120; i++ {
+		expectCurrentSessionSchema(mock)
+	}
+	var wg sync.WaitGroup
+	failures := make(chan bool, 120)
+	for i := 0; i < 120; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := postgresSessionStore(context.Background(), db, nil)
+			failures <- err != nil
+		}()
+	}
+	wg.Wait()
+	close(failures)
+	for failed := range failures {
+		if failed {
+			t.Fatal("concurrent borrower failed")
+		}
+	}
+	if db.Stats().MaxOpenConnections != 2 || db.Stats().OpenConnections > 2 {
+		t.Fatal("concurrent owner bounds changed")
+	}
+	mock.ExpectClose()
+	_ = db.Close()
+	if err = mock.ExpectationsWereMet(); err != nil {
+		t.Fatal("concurrent ownership expectations failed")
+	}
+}
