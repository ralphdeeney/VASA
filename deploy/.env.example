# Template only. Keep populated secrets in /opt/vasa/.local/vps.env with mode 0600.
# The deployment preparation script creates lower-case hex credentials safely.
# Do not commit populated files or display `docker compose config` with real credentials.

# Use different unused loopback host ports if these are already occupied.
# Evolution API AND /manager/login share EVOLUTION_PORT; VASA dashboard uses VASA_API_PORT.
EVOLUTION_PORT=18080
VASA_API_PORT=18081

# Required, stable across deployments. Database/Redis passwords must be URI-safe;
# generated lowercase hex avoids accidental URI escaping bugs.
# The initial deployment uses postgres so Evolution can create its separate auth/users databases.
POSTGRES_USER=postgres
POSTGRES_DB=vasa
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# GLOBAL_API_KEY also supplies VASA_EVOLUTION_ADMIN_KEY. A generated key secures
# administration but DOES NOT activate Evolution; complete its genuine license flow.
GLOBAL_API_KEY=

# At least 32 UTF-8 bytes. Never rotate these casually: the instance key determines
# instance authentication tokens, and the stream key signs short-lived media access.
CALL_STREAM_SIGNING_KEY=
VASA_EVOLUTION_INSTANCE_KEY=
